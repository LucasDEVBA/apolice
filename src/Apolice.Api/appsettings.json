{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning",
        "System.Net.Http.HttpClient": "Warning",
        "Microsoft.AspNetCore.DataProtection": "Error",
        "Npgsql": "Warning",
        "Microsoft.Hosting.Lifetime": "Information"
      }
    }
  },
  "AllowedHosts": "*",
  "Database": {
    "Provider": "Postgres"
  },
  "Messaging": {
    "Transport": "RabbitMq"
  },
  "Outbox": {
    "DispatchImediato": true
  },
  "Jwt": {
    "Issuer": "apolice-api",
    "Audience": "apolice-web",
    "AccessTokenMinutos": 15,
    "RefreshTokenDias": 7
  },
  "Cors": {
    "Origens": []
  },
  "FeatureManagement": {
    "LoginDemo": true,
    "TriagemAutomaticaSinistros": true,
    "DocumentoPdf": true,
    "EndossoOnline": true
  }
}

{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "installCommand": "pnpm install --frozen-lockfile",
  "buildCommand": "pnpm build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://msuzbxab6dp4qfz6nc7b4oljxe0xbrrw.lambda-url.us-east-1.on.aws/api/:path*"
    },
    {
      "source": "/scalar/:path*",
      "destination": "https://msuzbxab6dp4qfz6nc7b4oljxe0xbrrw.lambda-url.us-east-1.on.aws/scalar/:path*"
    },
    {
      "source": "/openapi/:path*",
      "destination": "https://msuzbxab6dp4qfz6nc7b4oljxe0xbrrw.lambda-url.us-east-1.on.aws/openapi/:path*"
    },
    {
      "source": "/health/:path*",
      "destination": "https://msuzbxab6dp4qfz6nc7b4oljxe0xbrrw.lambda-url.us-east-1.on.aws/health/:path*"
    },
    { "source": "/((?!api/|scalar/|openapi/|health/|assets/).*)", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/((?!api/|scalar/|openapi/|health/).*)",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self'; connect-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'"
        },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(), payment=()"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=63072000; includeSubDomains; preload"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    }
  ]
}
